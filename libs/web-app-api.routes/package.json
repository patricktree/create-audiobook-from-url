{
  "name": "@create-audiobook-from-url/web-app-api.routes",
  "private": true,
  "files": [
    "src/**"
  ],
  "type": "module",
  "imports": {
    "#src/*.ts": {
      "types": "./dist/types/*.d.ts",
      "default": "./src/*.ts"
    },
    "#src/*": {
      "types": "./dist/types/*",
      "default": "./src/*"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "turbo:build": "tsc --build ./tsconfig.json",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix",
    "turbo:test": "pnpm run test"
  },
  "dependencies": {
    "@create-audiobook-from-url/conversion-grants": "workspace:*",
    "@create-audiobook-from-url/create-audiobook-from-url-workflow": "workspace:*",
    "@create-audiobook-from-url/narration-document-creation": "workspace:*",
    "@hono/zod-openapi": "catalog:hono",
    "hono": "catalog:hono",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@create-audiobook-from-url/config-oxlint": "workspace:*",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@patricktree-stack/config-vitest": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
