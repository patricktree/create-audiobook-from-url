{
  "name": "@create-audiobook-from-url/cloudflare-worker",
  "private": true,
  "files": [
    "src/**"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\" \".wrangler\"",
    "deploy": "pnpm run build && wrangler deploy",
    "dev": "vite",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "preview": "vite preview",
    "start": "pnpm run dev",
    "turbo:build": "tsc --build ./tsconfig.json && vite build",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix"
  },
  "dependencies": {
    "@create-audiobook-from-url/api-server": "workspace:*",
    "@create-audiobook-from-url/conversion-grants": "workspace:*",
    "@create-audiobook-from-url/create-audiobook-from-url-workflow": "workspace:*",
    "@create-audiobook-from-url/web-app": "workspace:*",
    "react": "catalog:web-app",
    "react-dom": "catalog:web-app"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:web-app",
    "@create-audiobook-from-url/config-oxlint": "workspace:*",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@patricktree-stack/config-wyw-in-js": "workspace:*",
    "@tanstack/router-plugin": "catalog:web-app",
    "@types/node": "catalog:",
    "@types/react": "catalog:web-app",
    "@types/react-dom": "catalog:web-app",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "catalog:web-app",
    "@wyw-in-js/vite": "catalog:web-app",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:web-app",
    "wrangler": "catalog:"
  }
}
