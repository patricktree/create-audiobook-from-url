{
  "name": "@create-audiobook-from-url/web-app",
  "private": true,
  "type": "module",
  "imports": {
    "#src/*.ts": {
      "types": "./dist/types/*.d.ts",
      "default": "./src/*.ts"
    },
    "#src/*.tsx": {
      "types": "./dist/types/*.d.tsx",
      "default": "./src/*.tsx"
    },
    "#src/*": {
      "types": "./dist/types/*",
      "default": "./src/*"
    }
  },
  "exports": {
    "./package.json": "./package.json",
    "./main": {
      "types": "./dist/types/main.d.ts",
      "default": "./src/main.tsx"
    }
  },
  "scripts": {
    "build": "turbo run turbo:build",
    "clean": "del-cli --dot=true \"dist\" \"*.tsbuildinfo\"",
    "lint": "turbo run turbo:lint",
    "lint:fix": "turbo run turbo:lint:fix",
    "turbo:build": "tsc --build ./tsconfig.json",
    "turbo:lint": "oxlint --type-aware --max-warnings 0 .",
    "turbo:lint:fix": "pnpm run turbo:lint --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@create-audiobook-from-url/conversion-grants": "workspace:*",
    "@create-audiobook-from-url/web-app-api.client": "workspace:*",
    "@create-audiobook-from-url/web-app-api.routes": "workspace:*",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "@linaria/core": "^8.2.0",
    "@patricktree-stack/utils-ecma": "workspace:*",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "react": "catalog:web-app",
    "react-dom": "catalog:web-app"
  },
  "devDependencies": {
    "@create-audiobook-from-url/config-oxlint": "workspace:*",
    "@patricktree-stack/config-typescript": "workspace:*",
    "@types/react": "catalog:web-app",
    "@typescript/native": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:"
  }
}
